# Copy to .env and fill in. Shell environment variables take precedence.

# Required: TypeSafe API key for Jev (https://docs.typesafe.ai).
TYPESAFEAI_API_KEY=

# Optional: real phones on AWS Device Farm (metered, pay per device-minute).
# Any standard AWS credentials work. Prefer a key limited to
# AWSDeviceFarmFullAccess (see README). Or leave these empty and set
# JEVB_AWS_PROFILE / AWS_PROFILE to use a profile from ~/.aws.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=        # only for temporary credentials
# JEVB_AWS_PROFILE=
# Existing Device Farm project; default: a project named "jevb", created on first use.
# JEVB_DF_PROJECT_ARN=

# Optional: Claude names unlabeled controls in native apps (Haiku) and, as a
# last resort, locates a control on the screenshot (computer use).
# ANTHROPIC_API_KEY=

# Optional: a local Appium server instead of Device Farm (simulator, emulator, USB phone).
# JEVB_APPIUM_URL=http://127.0.0.1:4723
# JEVB_APPIUM_UDID=

# Optional behavior.
# JEVB_PACE=human          # or agent
# JEVB_IDLE_MS=120000      # close Chromium after this long idle
# JEVB_DEVICE_IDLE_MS=180000
# JEVB_HEADED=1            # show the browser window
# JEVB_CDP_URL=http://127.0.0.1:9333  # attach to Chrome from bin/jevb-chrome.sh
# JEVB_CHROME_PROFILE_DIR=Profile 1   # Chrome profile jevb-chrome.sh starts in
