{
  "name": "jevb",
  "version": "0.1.0",
  "description": "Browser and phone use for AI agents, in plain English: a small decision model (Jev) picks elements, judges screens and reads text, so the agent never reads page snapshots. Headless Chromium, your own Chrome, iOS and Android (AWS Device Farm or Appium).",
  "license": "MIT",
  "author": "Dmitriy Fabrikant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitya777/jevb.git"
  },
  "keywords": [
    "agents",
    "ai",
    "ai-agents",
    "appium",
    "aws-device-farm",
    "browser-automation",
    "browser-use",
    "chromium",
    "e2e",
    "jev",
    "playwright",
    "testing",
    "typesafe"
  ],
  "type": "module",
  "bin": {
    "jevb": "bin/jevb.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "LICENSE",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.mjs",
    "test:live": "JEVB_LIVE=1 node --test test/live/*.test.mjs",
    "preversion": "npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-device-farm": "^3.1141.0",
    "playwright-core": "1.57.0",
    "pngjs": "^7.0.0"
  },
  "homepage": "https://github.com/mitya777/jevb#readme",
  "bugs": {
    "url": "https://github.com/mitya777/jevb/issues"
  }
}
